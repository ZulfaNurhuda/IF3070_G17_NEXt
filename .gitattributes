# Force LF line endings for all text files
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.lockb binary

# Lockfiles: generated text, collapsed in GitHub diffs, regenerate on conflict
[attr]lockfile linguist-generated=true

*.lock lockfile
package-lock.json lockfile
npm-shrinkwrap.json lockfile
pnpm-lock.yaml lockfile
packages.lock.json lockfile
Package.resolved lockfile
go.sum lockfile
gradle.lockfile lockfile
.terraform.lock.hcl lockfile
